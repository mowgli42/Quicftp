{
    # Debug logging to see transfer details
    log {
        output stdout
        level DEBUG
    }
}

localhost {
    # Use self-signed certs for internal testing
    tls internal

    # Handle file uploads via WebDAV
    route /files/* {
        webdav {
            root /data/files
            prefix /files
        }
    }

    # Also allow standard GET downloads
    route /* {
        file_server {
            root /data/files
        }
    }
}
